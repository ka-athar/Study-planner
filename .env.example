# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AUTOMATED EMAIL NOTIFICATIONS (SMTP / Gmail App Password)
# Optional: If configured, the 24/7 background scheduler dispatches live emails to your inbox.
# If omitted, simulated delivery logs will record all dispatches.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# AUTOMATED WHATSAPP NOTIFICATIONS (Twilio / Webhook)
# Optional: If configured, sends background WhatsApp messages directly to your phone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_WEBHOOK_URL=

# AUTONOMOUS WEB PUSH NOTIFICATIONS (VAPID)
# Optional: Used by server-side cron scheduler for background web push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
